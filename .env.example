# ============================================================
# Ticket Booking System - Environment Configuration
# ============================================================

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ticket_booking"

# API Server Port
PORT=5000

# JSON Web Token Configuration
JWT_SECRET="your_secure_jwt_secret_key_here"
JWT_EXPIRES_IN="1h"

# Frontend Application Origin (for CORS)
FRONTEND_URL="http://localhost:5173"

# Seat Hold TTL (in minutes)
SEAT_HOLD_DURATION_MINUTES=10

# Waitlist Offer TTL (in minutes)
WAITLIST_OFFER_DURATION_MINUTES=15

# SMTP Email Configuration (Optional - falls back to simulated logging if omitted)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="Ticket Booking System <your_email@gmail.com>"

